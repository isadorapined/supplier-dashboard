# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Use the dashboard's copy button. A key pasted by mouse selection can contain
# a truncating "..." character, which breaks supabase-js before any request.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is NOT set here. It belongs only in Netlify's
# environment variables (tick "Contains secret values"), read by
# netlify/functions/admin-actions.js. Never prefix it with VITE_.
